TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_ADMIN_USERNAME=replace_with_username_without_at
WEB_ADMIN_USERNAME=replace_with_web_admin_username
WEB_ADMIN_PASSWORD=replace_with_a_long_random_password
WEB_SESSION_SECRET=optional_long_random_session_signing_secret
# Archive destination supergroup ID (get it with /chatid in the archive group).
# Unit/truck group IDs are saved in PostgreSQL when each group runs /activate;
# they do not need a separate environment variable here.
PTI_ARCHIVE_CHAT_ID=-1000000000000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pti_telegram
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
PTI_TIME_ZONE=America/New_York
